# Loan Saathi, copy to .env and fill in. .env is gitignored.

# Sarvam AI, one key, but NOTE the two different header names:
#   speech-to-text / text-to-speech  ->  header: api-subscription-key
#   /v1/chat/completions             ->  header: Authorization: Bearer
SARVAM_API_KEY=

# Anthropic, model is claude-opus-5 (see docs/API-REFERENCE.md)
ANTHROPIC_API_KEY=

# Which narrator to use for /explain: "template" | "sarvam" | "claude"
#
# NO LLM IS REQUIRED. The demo ships on "template": fixed Hindi/English sentences with the
# engine's numbers substituted in. That is the configuration that was tested, and it is also
# what makes the "the model never invents a number" claim true by construction.
# The two LLM options are a fluency polish only, and both are optional.
#   sarvam   -> sarvam-105b. THE DEMO DEFAULT. Sarvam is the event's official AI partner and pays
#               credits for building on it, so the headline demo runs Sarvam STT + LLM + TTS.
#   claude   -> claude-opus-5. The documented swap; also the structured-output path for intent.
#   template -> deterministic Hindi/English strings, ZERO network calls. The offline fallback.
# Start on "template" while building, switch to "sarvam" once the text flow works.
LS_NARRATOR=template

# Demo assumptions (brief 5.3) - configurable, NOT Paytm rules
# Comfort ceiling for right-sizing. MUST match app/engine.py BURDEN_CEILING.
# At 0.20 the demo offer already passes and right-sizing becomes a no-op, which kills
# the 'suggest a smaller loan' beat. Keep 0.15.
LS_RIGHTSIZE_THRESHOLD=0.15
LS_COACH_DIP_FRACTION=0.80

# Let the LLM answer questions the keyword parser does not recognise, grounded on the
# engine's numbers. The five scripted demo beats are untouched either way.
# Keep LS_NARRATOR=template: the pre-rendered audio cache is keyed on the template text.
LS_OPEN_QA=true

# Read an uploaded loan document with Sarvam Doc AI instead of the bundled sample offer.
# About Rs 1 per page. Turn off if Doc AI is slow at the venue.
LS_DOC_AI=true
